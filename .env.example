# ─────────────────────────────────────────────────────────────────────────────
# Pastel backend — environment template. Copy to `.env` and fill in.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3500
# Set to "true" on worker replicas (runs BullMQ processors + schedulers, no HTTP traffic served)
WORKER=false

# ── Database ────────────────────────────────────────────────────────────────
# DATABASE_URL routes through PgBouncer (transaction pooling) in prod.
# DIRECT_URL bypasses the pooler — required by `prisma migrate` and the perf SQL.
DATABASE_URL="postgresql://localhost:5432/pastel_dev?schema=public"
DIRECT_URL="postgresql://localhost:5432/pastel_dev?schema=public"
# Optional read-replica DSN. If unset, reads fall back to DATABASE_URL (single node dev).
DATABASE_REPLICA_URL=""

# ── Redis (cache + rate-limit + BullMQ backend) ──────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth ──────────────────────────────────────────────────────────────────────
# RS256/ES256 keypair (PEM). For dev you may use HS256 by setting JWT_SECRET instead.
JWT_ALG=RS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_SECRET=dev-only-change-me
JWT_ACCESS_TTL=900            # seconds (15m)
JWT_REFRESH_TTL=2592000       # seconds (30d)
COOKIE_NAME=pa_at
COOKIE_DOMAIN=
CSRF_SECRET=dev-only-change-me

# ── Stripe Connect ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_REFRESH_URL=https://app.mypastel.com/stripe/refresh
STRIPE_CONNECT_RETURN_URL=https://app.mypastel.com/stripe/return

# ── Tax / Shipping / Email / Push / AI ──────────────────────────────────────
TAXJAR_API_TOKEN=
TAX_JAR_NEXUS_STATES=
SHIPPO_API_TOKEN=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
FCM_SERVICE_ACCOUNT_JSON=
GEMINI_API_KEY=

# ── Object storage (S3-compatible) ───────────────────────────────────────────
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=pastel-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=

# ── Live video orchestrator ──────────────────────────────────────────────────
LIVEKIT_ORCHESTRATOR_URL=https://api.ivector.co

# ── Ops ──────────────────────────────────────────────────────────────────────
# Operator credential for /admin/* routes (X-Operator-Secret header). Required in prod.
ADMIN_SECRET=
SENTRY_DSN=
LOG_LEVEL=debug
